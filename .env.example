# Instagram Graph API (via Facebook Login)
# 長期ユーザーアクセストークン (約60日で失効)
IG_ACCESS_TOKEN=
# Instagram Business Account ID
IG_USER_ID=
# Graph API のバージョン (公式最新は v27.0。無印環境では v23.0 以上推奨)
IG_GRAPH_VERSION=v23.0

# Kling API (https://api-singapore.klingai.com など地域別ドメイン)
# 認証方式は 2 通り: どちらか一方を設定すれば動く。KLING_API_KEY が優先。
#  (1) 新方式 (推奨): コンソールの "Create a new API Key" で発行した単体 API Key
KLING_API_KEY=
#  (2) 旧方式 (Legacy): Access Key + Secret Key ペア (JWT 署名用)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
# 現行モデル: kling-v3-0, kling-v3-0-turbo, kling-v2-6, kling-v2-5 など
KLING_MODEL=kling-v2-6
# std (720p) / pro (1080p)
KLING_MODE=std
# 秒数 ("5" または "10")
KLING_DURATION=5
# 環境音生成 ("on" または "off"、v2.6 以上で対応)
KLING_SOUND=on

# Claude (Anthropic) API
ANTHROPIC_API_KEY=
# 使うモデル (vision + text を同じモデルで)
CLAUDE_MODEL=claude-sonnet-4-6

# true なら Instagram 投稿を行わず動画生成までで止める
DRY_RUN=false
